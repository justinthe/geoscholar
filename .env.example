# Copy to .env and adjust. Read by Docker Compose and, for local development, by config.py.
GEOSCHOLAR_LLM=llama3.1:8b          # exact Ollama model name; on CPU-only machines try a 3B model
GEOSCHOLAR_RETRIEVAL_MODE=hybrid    # dense | bm25 | hybrid  (your week 3 decision)
GEOSCHOLAR_USE_RERANK=true
GEOSCHOLAR_TOP_K=5                  # your week 4 decision
GEOSCHOLAR_CONTEXT_ORDER=relevance
GEOSCHOLAR_CHUNK_TOKENS=300